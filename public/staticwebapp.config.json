{
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/ingen-tilgang.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*", "allowedRoles": ["lagerbruker"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/github?post_login_redirect_uri=/", "statusCode": 302 },
    "403": { "rewrite": "/ingen-tilgang.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin"
  },
  "platform": { "apiRuntime": "node:20" }
}
